# Required — Get a free Gemini key at: https://aistudio.google.com/app/apikey
BUGREPLAY_API_KEY=your_api_key_here

# AI Provider: gemini | openai | anthropic (default: gemini)
BUGREPLAY_AI_PROVIDER=gemini

# Model to use (provider-specific)
BUGREPLAY_MODEL=gemini-flash-latest

# Optional: Custom API base URL (for proxies or local deployments)
# BUGREPLAY_API_BASE_URL=

# Log level: debug | info | warn | error (default: info)
BUGREPLAY_LOG_LEVEL=info

# Max lines of source context around a stack frame (default: 30)
BUGREPLAY_CONTEXT_LINES=30
