# Required for Gemini. Get a free key at:
# https://aistudio.google.com/app/apikey
BUGREPLAY_API_KEY=your_api_key_here

# AI Provider: gemini (openai/anthropic planned)
BUGREPLAY_AI_PROVIDER=gemini

# Model to use (provider-specific)
BUGREPLAY_MODEL=gemini-flash-latest

# Optional: Custom API base URL (for proxies or local deployments)
# BUGREPLAY_API_BASE_URL=

# Log level: debug | info | warn | error (default: info)
BUGREPLAY_LOG_LEVEL=info

# Max lines of source context around a stack frame (default: 30)
BUGREPLAY_CONTEXT_LINES=30

# AI request timeout and retry count
BUGREPLAY_API_TIMEOUT_MS=60000
BUGREPLAY_AI_RETRIES=3

# Maximum time allowed for a test command
BUGREPLAY_TEST_TIMEOUT_MS=120000

# Do not automatically apply low-confidence fixes
BUGREPLAY_MIN_FIX_CONFIDENCE=75

# Reserved for future anonymous telemetry; currently disabled and no data is sent
BUGREPLAY_TELEMETRY=false
